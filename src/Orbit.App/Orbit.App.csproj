<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit.App</RootNamespace>
    <Version>0.5.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Orbit.Core/Orbit.Core.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/tessdata/*.traineddata" Link="tessdata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgTesseract)/x64/*.dll" Link="x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateOcrModels" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../../assets/tessdata/vie.traineddata') Or !Exists('../../assets/tessdata/eng.traineddata')" Text="Thiếu mô hình OCR. Chạy scripts/prepare-ocr.ps1 trước khi build." />
  </Target>
</Project>
